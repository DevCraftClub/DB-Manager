<h2>{{ 'История изменений'|trans }}</h2>

{% if changelog is defined and changelog|length > 0 %}
    <ul class="timeline dc-changelog-timeline">
        {% for entry in changelog %}
            <li{% if loop.last %} class="timeline-end"{% endif %}>
                <span class="time">
                    {% if entry.version == 'Неопубликованное'|trans %}
                        Unreleased
                    {% else %}
                        v{{ entry.version }}
                    {% endif %}
                    {% if entry.date %}
                        — {{ entry.date }}
                    {% endif %}
                </span>
                <div class="data">
                    {% for section in entry.sections %}
                        <h5 class="dc-changelog-section">{{ section.title }}</h5>
                        <ul>
                            {% for item in section.items %}
                                <li>{{ item.text|raw }}</li>
                            {% endfor %}
                        </ul>
                    {% endfor %}
                </div>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p>{{ 'Записей в истории изменений нет.'|trans }}</p>
{% endif %}
